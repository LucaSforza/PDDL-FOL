// Blocks world with explicit Clear facts; the initial state includes On(c,a).
problem blocks {
  types block;
  objects { a, b, c: block; }
  predicates { On(block, block); OnTable(block); Clear(block); }
  init: On(c, a) and OnTable(a) and OnTable(b) and Clear(c) and Clear(b);
  goal: On(a, b) and On(b, c) and OnTable(c);

  action Unstack(x: block, y: block) {
    pre: On(x, y) and Clear(x);
    effect: not On(x, y) and OnTable(x) and Clear(y);
  }
  action Stack(x: block, y: block) {
    pre: OnTable(x) and Clear(x) and Clear(y) and x != y;
    effect: not OnTable(x) and On(x, y) and not Clear(y);
  }
}
