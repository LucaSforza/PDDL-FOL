// Carry a package from the depot to the hub.
problem logistics {
  types location, package, truck;
  objects { depot, hub: location; parcel: package; van: truck; }
  predicates {
    AtPackage(package, location);
    AtTruck(truck, location);
    Road(location, location);
    In(package, truck);
  }
  init: AtPackage(parcel, depot) and AtTruck(van, depot)
    and Road(depot, hub) and Road(hub, depot);
  goal: AtPackage(parcel, hub);

  action Drive(t: truck, from: location, to: location) {
    pre: AtTruck(t, from) and Road(from, to);
    effect: not AtTruck(t, from) and AtTruck(t, to);
  }
  action Load(p: package, t: truck, l: location) {
    pre: AtPackage(p, l) and AtTruck(t, l);
    effect: not AtPackage(p, l) and In(p, t);
  }
  action Unload(p: package, t: truck, l: location) {
    pre: In(p, t) and AtTruck(t, l);
    effect: not In(p, t) and AtPackage(p, l);
  }
}
