// The universal goal requires every item to be inspected.
problem inspection {
  types item, inspector;
  objects { sample_a, sample_b: item; robot: inspector; }
  predicates { Pending(item); Inspected(item); CanInspect(inspector, item); }
  init: Pending(sample_a) and Pending(sample_b)
        and CanInspect(robot, sample_a) and CanInspect(robot, sample_b);
  goal: forall x: item . Inspected(x);

  action Inspect(x: item) {
    pre: Pending(x) and (exists worker: inspector . CanInspect(worker, x));
    effect: not Pending(x) and Inspected(x);
  }
}
