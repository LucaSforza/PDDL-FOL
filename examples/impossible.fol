// There is no road from the initial location to the goal location.
problem impossible {
  types place;
  objects { start, goal: place; }
  predicates { At(place); Road(place, place); }
  init: At(start);
  goal: At(goal);

  action Move(from: place, to: place) {
    pre: At(from) and Road(from, to);
    effect: not At(from) and At(to);
  }
}
